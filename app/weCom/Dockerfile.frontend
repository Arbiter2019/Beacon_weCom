ARG DOCKER_REGISTRY=docker.m.daocloud.io
FROM ${DOCKER_REGISTRY}/library/node:22-alpine AS build
WORKDIR /srv/wecom/frontend
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm config set registry https://registry.npmmirror.com
RUN npm install
COPY frontend ./
ARG VITE_INTERNAL_ADMIN_TOKEN
ENV VITE_INTERNAL_ADMIN_TOKEN=$VITE_INTERNAL_ADMIN_TOKEN
RUN npm run build

FROM ${DOCKER_REGISTRY}/library/nginx:1.27-alpine
COPY --from=build /srv/wecom/frontend/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
