FROM node:22-alpine AS build
WORKDIR /srv/wecom/frontend
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend ./
ARG VITE_INTERNAL_ADMIN_TOKEN
ENV VITE_INTERNAL_ADMIN_TOKEN=$VITE_INTERNAL_ADMIN_TOKEN
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /srv/wecom/frontend/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
