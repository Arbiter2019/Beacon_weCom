MYSQL_ROOT_PASSWORD=change-root-me

WECOM_CORP_ID=

# 通讯录 API 同步员工/部门时填写；仅使用 CSV 导入名单时可留空。
WECOM_CONTACT_SECRET=
# 通讯录变更回调参数。若企业微信后台已被其他项目占用，可留空，改用 CSV 导入或通讯录 API 定时同步。
WECOM_CONTACT_CALLBACK_TOKEN=
WECOM_CONTACT_ENCODING_AES_KEY=

# 客户联系 API access_token 使用的 secret。
# 推荐填写已被配置到客户联系“可调用应用”中的自建应用 Secret。
# 旧环境变量 WECOM_CUSTOMER_SECRET 仍兼容，但新部署建议使用 WECOM_CUSTOMER_API_SECRET。
WECOM_CUSTOMER_API_SECRET=
WECOM_CUSTOMER_CALLBACK_TOKEN=
WECOM_CUSTOMER_ENCODING_AES_KEY=

WECOM_ARCHIVE_SECRET=
WECOM_ARCHIVE_CALLBACK_TOKEN=
WECOM_ARCHIVE_ENCODING_AES_KEY=

WECOM_ARCHIVE_PRIVATE_KEY_PATH=/run/secrets/wecom_archive_private_key.pem
WECOM_SDK_LIB_DIR=/opt/wecom_sdk

ATTACHMENT_STORAGE_ROOT=/data/wecom/attachments
INTERNAL_ADMIN_TOKEN=replace-with-a-long-random-token
VITE_INTERNAL_ADMIN_TOKEN=replace-with-a-long-random-token

# 阿里云的OSS
ATTACHMENT_STORAGE_BACKEND=aliyun_oss
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_PREFIX=
ALIYUN_OSS_INTERNAL_ENDPOINT=
ALIYUN_OSS_PUBLIC_BASE_URL=https://res.jhpy.com/wecom/
ALIYUN_OSS_CONNECT_TIMEOUT_SECONDS=15
ALIYUN_OSS_READ_TIMEOUT_SECONDS=60